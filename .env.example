# Copy to .env.local for local development, and add the same keys in Vercel → Settings → Environment Variables.

# Chain: 5042 = Arc Mainnet (default). 31337 = local Hardhat node for development only.
NEXT_PUBLIC_CHAIN_ID=5042

# GiftRegistry contract address from contracts/deployments/arcMainnet.json
NEXT_PUBLIC_REGISTRY_ADDRESS=

# Only used when NEXT_PUBLIC_CHAIN_ID=31337 (mock USDC address). On Arc the canonical
# USDC address 0x3600000000000000000000000000000000000000 is always used.
NEXT_PUBLIC_USDC_ADDRESS=

# Optional server-side RPC override (defaults to https://rpc.mainnet.arc.io)
RPC_URL=

# Supabase (server-side only - never prefix these with NEXT_PUBLIC_).
# Without them, local dev falls back to a JSON file in .data/; production requires them.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
