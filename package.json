{
  "name": "gift-registry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "e2e:local": "node scripts/e2e-local.mjs",
    "deploy:testnet": "npm --prefix contracts run deploy:testnet",
    "smoke:testnet": "npm --prefix contracts run smoke:testnet",
    "deploy:arc": "npm --prefix contracts run deploy:arc",
    "smoke:arc": "npm --prefix contracts run smoke:arc",
    "keystore:set": "cd contracts && npx hardhat keystore set ARC_PRIVATE_KEY",
    "test:contracts": "npm --prefix contracts test",
    "check:testnet": "node scripts/check-deployment.mjs arcTestnet",
    "check:arc": "node scripts/check-deployment.mjs arcMainnet"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.2",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "viem": "^2.57.5",
    "wagmi": "^3.7.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
